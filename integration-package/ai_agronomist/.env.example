# ==============================================================================
# FertoBot AI Agronomist Environment Configuration Template
# Copy this file to .env in your root or backend directory and populate your keys.
# DO NOT COMMIT LIVE API KEYS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Optional regex for dynamic deployment previews (e.g. Vercel preview branches)
# CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ==============================================================================
# LLM Orchestrator Configuration (Gemini 2.5 Flash / Flash Lite)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_REQUEST_TIMEOUT_SECONDS=12.0

# Optional Alternative LLM Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Indic Voice AI Configuration (GNANI.ai Prisma STT & Timbre TTS)
# ==============================================================================
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto

# GNANI Timbre TTS Endpoints & Voice Personas
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_ENDPOINT=https://api.vachana.ai/api/v1/stt/transcribe
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_HINDI_VOICE=Nalini
GNANI_TTS_ENGLISH_VOICE=Kaveri
GNANI_TTS_HINGLISH_VOICE=Poorvi
GNANI_TTS_SPEED=1.0

# GNANI Concurrency & Resilience Controls
GNANI_REQUEST_TIMEOUT_SECONDS=10.0
GNANI_TTS_CONCURRENCY_LIMIT=2
GNANI_TTS_MAX_RETRIES=3

# Active Provider Defaults (gnani, browser, or mock)
TTS_PROVIDER=gnani
STT_PROVIDER=browser
CONVERSATION_PROVIDER=orchestrator

# ==============================================================================
# Hardware Safety & Actuation Boundary
# ==============================================================================
# Must remain true in staging and advisory-only environments
SIMULATION_MODE=true
# Set to false to prevent automated hardware pump triggering without human approval card
ACTUATION_PERMITTED=false

# Passkey for diagnostic test condition endpoints
TEAM_REVIEW_PASSKEY=
