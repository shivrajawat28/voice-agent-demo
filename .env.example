# ==============================================================================
# FertoBot Voice Agent Demo — Unified Staging Environment Variables Template
# ==============================================================================
# SECURITY NOTICE:
# - Place actual values in your hosting dashboard (e.g. Render Environment Variables).
# - NEVER commit real credentials to Git.
# ==============================================================================

# Network & Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://fertobot-staging.onrender.com,http://localhost:5174,http://localhost:5173,http://127.0.0.1:8000

# Safety Guardrails (Strict Hardware Safety)
SIMULATION_MODE=true
ACTUATION_PERMITTED=false

# Provider Selections
CONVERSATION_PROVIDER=orchestrator
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
TTS_PROVIDER=gnani
STT_PROVIDER=gnani_prisma_v3

# LLM Credentials (Backend Secret)
GEMINI_API_KEY=your_gemini_api_key_here

# GNANI AI Speech Credentials (Backend Secret)
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_HINDI_VOICE=Nalini
GNANI_TTS_ENGLISH_VOICE=Kaveri
GNANI_TTS_HINGLISH_VOICE=Poorvi

# Diagnostic Gate Passkey (Required for /api/farm/telemetry/simulate-condition in Staging)
TEAM_REVIEW_PASSKEY=your_team_review_passkey_here
