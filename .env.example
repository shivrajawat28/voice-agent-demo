# ==============================================================================
# FertoBot Voice Agent Demo — Environment Variables Configuration Template
# ==============================================================================
# CRITICAL SECURITY INVARIANT:
# - Frontend variables prefixed with VITE_* are bundled into PUBLIC browser JavaScript.
# - NEVER put secret tokens, private keys, or credentials in VITE_* variables.
# - Backend secrets (GEMINI_API_KEY, GNANI_API_KEY) MUST reside strictly on the server.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client Application)
# ------------------------------------------------------------------------------
# In local dev and Render monolithic deployment, leave these UNSET to use relative paths.
# For decoupled deployments (e.g. Vercel frontend + Google Cloud Run backend):
# VITE_API_BASE_URL=https://your-cloud-run-backend.a.run.app
# VITE_WS_URL=wss://your-cloud-run-backend.a.run.app/api/ws/stt
VITE_API_BASE_URL=
VITE_WS_URL=

# ------------------------------------------------------------------------------
# BACKEND NETWORK & CORS CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed web origins for HTTP CORS and WebSocket Origin validation.
# Note: Wildcard '*' is strictly prohibited when credentials are enabled.
CORS_ORIGINS=https://fertobot-staging.onrender.com,http://localhost:5174,http://localhost:5173,http://127.0.0.1:8000

# Optional Regex pattern to allow dynamic preview branches (e.g. Vercel preview URLs)
# CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ------------------------------------------------------------------------------
# HARDWARE SAFETY & ACTUATION BOUNDARY
# ------------------------------------------------------------------------------
# SIMULATION_MODE must remain true in staging and demo environments
SIMULATION_MODE=true
# ACTUATION_PERMITTED must remain false to prevent physical hardware relay actuation
ACTUATION_PERMITTED=false

# ------------------------------------------------------------------------------
# PROVIDER SELECTIONS
# ------------------------------------------------------------------------------
CONVERSATION_PROVIDER=orchestrator
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_REQUEST_TIMEOUT_SECONDS=12.0
TTS_PROVIDER=gnani
STT_PROVIDER=gnani_prisma_v3

# ------------------------------------------------------------------------------
# LLM INTELLIGENCE CREDENTIALS (Server Secret Only)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Optional OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# GNANI INDIC VOICE CREDENTIALS & PIPELINE (Server Secret Only)
# ------------------------------------------------------------------------------
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto

# GNANI Timbre TTS Endpoints & Voice Personas
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_ENDPOINT=https://api.vachana.ai/api/v1/stt/transcribe
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_HINDI_VOICE=Nalini
GNANI_TTS_ENGLISH_VOICE=Kaveri
GNANI_TTS_HINGLISH_VOICE=Poorvi
GNANI_TTS_SPEED=1.0

# Rate-limit and concurrency controls
GNANI_REQUEST_TIMEOUT_SECONDS=10.0
GNANI_TTS_CONCURRENCY_LIMIT=2
GNANI_TTS_MAX_RETRIES=3

# Diagnostic review passkey for staging test routes
TEAM_REVIEW_PASSKEY=your_team_review_passkey_here

# ==============================================================================
# DEPLOYMENT SCENARIO REFERENCE EXAMPLES
# ==============================================================================
#
# SCENARIO A: Local Development (Vite Dev Server + Local FastAPI Uvicorn)
#   VITE_API_BASE_URL=                  (leave empty; Vite proxies /api to port 8000)
#   VITE_WS_URL=                        (leave empty; resolves to ws://localhost:5174/api/ws/stt)
#   CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://127.0.0.1:8000
#
# SCENARIO B: Existing Render Deployment (Monolithic Container)
#   VITE_API_BASE_URL=                  (leave empty; served on same origin)
#   VITE_WS_URL=                        (leave empty; resolves to wss://fertobot-staging.onrender.com/api/ws/stt)
#   CORS_ORIGINS=https://fertobot-staging.onrender.com,http://localhost:5174,http://localhost:5173,http://127.0.0.1:8000
#
# SCENARIO C: Future Decoupled Deployment (Vercel Frontend + Google Cloud Run Backend)
#   [On Vercel]:
#     VITE_API_BASE_URL=https://fertobot-voice-backend-xxxxxx.a.run.app
#     VITE_WS_URL=wss://fertobot-voice-backend-xxxxxx.a.run.app/api/ws/stt
#   [On Google Cloud Run]:
#     CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5174,http://localhost:5173
#     CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
#     GEMINI_API_KEY=(Mounted from Google Cloud Secret Manager)
#     GNANI_API_KEY=(Mounted from Google Cloud Secret Manager)
# ==============================================================================
