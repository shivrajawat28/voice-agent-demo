# ==============================================================================
# FertoBot Voice Agent Backend Environment Configuration Template
# ==============================================================================
# CRITICAL SECURITY NOTICE:
# - NEVER commit a real .env file or live credentials to Git.
# - Keep API keys and secrets strictly on the backend / cloud secret manager.
# - Do NOT pass API keys to the frontend.
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Allowed CORS origins for HTTP cross-origin requests and WebSocket Origin validation.
# Multiple origins must be comma-separated. Wildcard '*' is rejected when credentials are true.
CORS_ORIGINS=https://fertobot-staging.onrender.com,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional Regex pattern to allow dynamic deployment previews (e.g. Vercel preview branches)
# CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Hardware Safety & Actuation Boundary
SIMULATION_MODE=true
ACTUATION_PERMITTED=false

# Active Provider Selections
CONVERSATION_PROVIDER=orchestrator

# LLM Provider Configuration (mock, gemini, openai)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_REQUEST_TIMEOUT_SECONDS=12.0
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Speech Provider Configuration
# TTS_PROVIDER: gnani, browser, mock
TTS_PROVIDER=gnani
# STT_PROVIDER: gnani_prisma_v3, browser, mock
STT_PROVIDER=gnani_prisma_v3

# Gnani AI (Vachana) Credentials & Endpoints
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_STT_ENDPOINT=https://api.vachana.ai/api/v1/stt/transcribe
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_HINDI_VOICE=Nalini
GNANI_TTS_ENGLISH_VOICE=Kaveri
GNANI_TTS_HINGLISH_VOICE=Poorvi
GNANI_TTS_SPEED=1.0

# Rate-limit and concurrency controls
GNANI_REQUEST_TIMEOUT_SECONDS=10.0
GNANI_TTS_CONCURRENCY_LIMIT=2
GNANI_TTS_MAX_RETRIES=3

# Diagnostic review passkey for staging test routes
TEAM_REVIEW_PASSKEY=your_team_review_passkey_here
