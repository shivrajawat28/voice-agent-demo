# ==============================================================================
# FertoBot Voice Agent Backend Environment Configuration
# ==============================================================================
# CRITICAL SECURITY NOTICE:
# - NEVER commit a real .env file or credentials to Git.
# - Keep API keys and secrets strictly on the backend.
# - Do NOT pass API keys to the frontend.
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Active Provider Selections
# Options for CONVERSATION_PROVIDER: orchestrator, deterministic
CONVERSATION_PROVIDER=orchestrator

# LLM Provider Configuration
# Options for LLM_PROVIDER: mock, gemini, openai
LLM_PROVIDER=gemini
# Optional API keys for live LLM providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-flash-lite-latest
LLM_REQUEST_TIMEOUT_SECONDS=12.0

# Options for TTS_PROVIDER: gnani, mock, browser
# - "gnani": Proxies synthesis requests to Gnani Vachana TTS API (requires GNANI_API_KEY)
#           If GNANI_API_KEY is unset, falls back cleanly to Browser Native speech.
# - "mock": Returns predictable local synthetic audio for offline testing.
# - "browser": Client uses native browser SpeechSynthesis directly.
TTS_PROVIDER=gnani

# Options for STT_PROVIDER: gnani_prisma_v3, browser, mock
# - "gnani_prisma_v3": Backend WebSocket proxy to wss://api.vachana.ai/stt/v3/stream (requires GNANI_API_KEY).
# - "browser": Client Web Speech API handles recognition (recommended fallback for demo).
# - "mock": Returns mock transcription fixtures.
STT_PROVIDER=browser

# Gnani AI (Vachana) Credentials & Endpoints
# Primary Auth Header: X-API-Key-ID: <your_api_key>
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=indic-auto
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_HINDI_VOICE=Nalini
GNANI_TTS_ENGLISH_VOICE=Kaveri
GNANI_TTS_HINGLISH_VOICE=Poorvi
GNANI_TTS_SPEED=1.0
GNANI_REQUEST_TIMEOUT_SECONDS=10.0
